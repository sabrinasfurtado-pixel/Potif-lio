# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Port where Express server listens
PORT="3000"

# JWT_SECRET: Secret key for signing admin authentication tokens
JWT_SECRET="YOUR_SECURE_RANDOM_SECRET_KEY"

# ADMIN_EMAIL: Initial administrator email account
ADMIN_EMAIL="sabrina.s.furtado@gmail.com"

# ADMIN_INITIAL_PASSWORD: Password used on first database initialization
ADMIN_INITIAL_PASSWORD="CHANGE_ME_IN_PRODUCTION!"
